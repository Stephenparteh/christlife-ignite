# Final public domain, no trailing slash, e.g. https://www.example.org
# Leave empty until the custom domain is connected and serving over HTTPS.
# While empty, the build skips canonical URLs, og:url, og:image, sitemap.xml
# and the robots.txt Sitemap line (so no temporary hosting URL is baked in).
VITE_SITE_URL=

# Base URL of the Express API (see server/), if it's ever hosted on a
# different origin than this static site (e.g. a separate api.<domain>).
# Leave empty if the API is reverse-proxied under /api on this same domain
# — the frontend then just calls relative "/api/..." paths, no CORS needed.
# Safe to expose: this is a public endpoint URL, never a secret.
VITE_API_URL=
