# Copy this file to `.env` in the same folder and fill in real values.
# `.env` is gitignored — never commit real secrets.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (see server/README.md for how to get one).
# Example shape: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=
# Database name. "christ_life" is used regardless of what's in the URI path.
MONGODB_DB_NAME=christ_life

# Long random string used to sign session tokens — never reuse across projects.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How many days a login stays valid for.
AUTH_SESSION_DAYS=7

# Comma-separated list of frontend origins allowed to call this API with
# credentials (cookies). The Vite dev server defaults to port 8080; in dev
# the frontend actually talks to this API through Vite's proxy, so requests
# arrive same-origin and this mostly matters if you bypass the proxy or once
# a real production domain is connected.
CLIENT_ORIGINS=http://localhost:8080

# Cookie SameSite mode. "lax" is correct for local dev and for a production
# setup where the dashboard and API share a domain. Only switch to "none"
# (which requires HTTPS/Secure, i.e. NODE_ENV=production) if the dashboard
# and API end up deployed on two different domains.
COOKIE_SAMESITE=lax
COOKIE_NAME=cl_session

# Used only by `npm run create-admin` to create the first administrator
# account. Not read by the running server — remove these three lines from
# your local .env after you've created the account.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
